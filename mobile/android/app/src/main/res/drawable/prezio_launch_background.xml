<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/prezio_launch_bottom"
                android:startColor="@color/prezio_launch_top" />
        </shape>
    </item>
    <!-- Same white rounded badge card the logo sits in on Login/Register (heroBadge),
         so the logo's own drop shadow reads against the light card it was designed
         for instead of showing as a seam against this dark gradient. -->
    <item
        android:width="116dp"
        android:height="116dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/prezio_white" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item
        android:width="116dp"
        android:height="116dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/prezio_launch_logo" />
    </item>
</layer-list>
