# Copy this file to `.env` (untracked, at the mobile/ root) and adjust per environment.
# Loaded at native build time by react-native-config, exposed in JS via `Config` from 'react-native-config'.
# NOTE: this scaffold could not write a real .env file directly (sandbox blocks writing dotenv files);
# create it manually from this template before running the app.

# Backend base URL.
# Android emulator -> host machine loopback is 10.0.2.2, NOT localhost.
API_BASE_URL=http://10.0.2.2:8000
WS_BASE_URL=ws://10.0.2.2:8000/shopping-lists/ws

# Obtained from Google Cloud Console (OAuth 2.0 Web client ID, used as the
# "webClientId" for @react-native-google-signin/google-signin so the ID token
# audience matches what the backend expects).
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_REAL_GOOGLE_WEB_CLIENT_ID
