# Copy this file to `.env` (untracked, at the backend/ root) and adjust per environment.
# Loaded by pydantic-settings (see app/core/config.py); every field on `Settings` can be
# overridden this way -- these are just the ones that normally differ per environment.

# Async SQLAlchemy needs the `+asyncpg` driver in the scheme. If you're pointing at a
# managed Postgres (e.g. Neon) whose connection string came from `psql`/libpq, drop
# `sslmode`/`channel_binding` query params -- asyncpg doesn't understand them and negotiates
# TLS on its own when the server requires it.
DATABASE_URL=postgresql+asyncpg://prezio:prezio@localhost:5432/prezio
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
GOOGLE_CLIENT_ID=REPLACE_WITH_REAL_GOOGLE_CLIENT_ID

ENVIRONMENT=development

# Comma-separated list is NOT supported here -- pydantic-settings parses this as a JSON array,
# e.g. CORS_ORIGINS=["https://admin.prezio.example"]. Defaults to web-admin's local Vite dev
# server only. CORSMiddleware sets allow_credentials=True, so this must NEVER be ["*"] in any
# environment that serves real traffic -- wildcard-plus-credentials tells browsers (and
# Starlette) to reflect any Origin back, which defeats CORS entirely. Set this to the real
# web-admin domain(s) before deploying.
CORS_ORIGINS=["http://localhost:5173"]

# Product image uploads (app/features/catalog/image_storage.py). Until all four are set, the
# mobile "create product" flow's POST /catalog/products/image-upload-url returns 503. Use an
# IAM user scoped to PutObject on this one bucket -- never reuse root/admin AWS credentials here.
AWS_REGION=REPLACE_WITH_AWS_REGION
AWS_S3_BUCKET=REPLACE_WITH_S3_BUCKET_NAME
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
