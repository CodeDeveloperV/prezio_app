# Copy this file to `.env` (untracked, at the backend/ root) and adjust per environment.
# Loaded by pydantic-settings (see app/core/config.py); every field on `Settings` can be
# overridden this way -- these are just the ones that normally differ per environment.

# Async SQLAlchemy needs the `+asyncpg` driver in the scheme. If you're pointing at a
# managed Postgres (e.g. Neon) whose connection string came from `psql`/libpq, drop
# `sslmode`/`channel_binding` query params -- asyncpg doesn't understand them and negotiates
# TLS on its own when the server requires it.
DATABASE_URL=postgresql+asyncpg://prezio:prezio@localhost:5432/prezio
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
GOOGLE_CLIENT_ID=REPLACE_WITH_REAL_GOOGLE_CLIENT_ID

ENVIRONMENT=development
